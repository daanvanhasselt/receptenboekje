  "stappen": [
    { "tekst": "Verhit {olijfolie} in de cocotte op middelhoog vuur. Fruit {ui} en {paprika} met een snuf zout tot ze zacht en licht gekleurd zijn — neem hier echt de tijd voor, dit is de smaakbodem.", "duur": 10 },
    { "tekst": "Voeg {knoflook}, {komijn}, {paprikapoeder}, {chilivlokken} en {tomatenpuree} toe. Bak al roerend mee tot het intens geurt — niet langer, anders verbrandt de knoflook.", "duur": 2 },
    { "tekst": "Giet {tomaten} erbij en druk ze grof kapot met een houten lepel. Breng op smaak met {smaakmakers}. Laat zonder deksel zachtjes pruttelen tot de saus dik is en niet meer waterig — een spoor van de lepel moet even zichtbaar blijven op de bodem.", "duur": 2, "wachttijd": 18 },
    { "tekst": "Roer {bonen} door de saus en laat een paar minuten meewarmen. Proef en corrigeer: meestal kan er nog wat zout of chili bij.", "duur": 3 },
    { "tekst": "Zet het vuur laag. Maak met de lepel kuiltjes in de saus en breek in elk kuiltje een ei van {eieren}. Bestrooi met wat zout en leg het deksel op de cocotte. Zachte dooiers: 8–10 minuten; volledig gestold: 12–14 minuten.", "duur": 4, "wachttijd": 10 },
    { "tekst": "Verkruimel {feta} over de pan en strooi er {koriander} en eventueel {sumak} over. Zet de cocotte op een onderzetter midden op tafel en serveer met {brood} om te dopen, eventueel met {yoghurt}.", "duur": 3 }
  ]
