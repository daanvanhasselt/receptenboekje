---
import Basis from '../layouts/Basis.astro';
import { pad } from '../lib/pad';
---
<Basis titel="Boodschappen" actief="boodschappen">
  <h1>🛒 Boodschappen</h1>
  <form class="toevoegen" id="toevoegen">
    <input type="text" id="invoer" placeholder="Voeg toe… (bijv. appels)" autocomplete="off" />
    <select id="invoer-aantal" aria-label="Aantal">
      {Array.from({ length: 10 }, (_, index) => (
        <option value={index + 1} selected={index === 0}>{index + 1}</option>
      ))}
    </select>
    <button type="submit" aria-label="Voeg toe">+</button>
  </form>
  <details class="ai-instellingen">
    <summary>AI-instellingen</summary>
    <label for="api-sleutel">Anthropic API-sleutel</label>
    <input type="password" id="api-sleutel" autocomplete="off" placeholder="sk-ant-…" />
    <p>Wordt alleen in deze browser bewaard en gebruikt om de categorie automatisch te herkennen. Zonder sleutel komt alles onder "Overig".</p>
  </details>
  <p class="leeg" id="leeg" hidden>
    Nog niets op de lijst. Open een <a href={pad('')}>recept</a> en druk op "Zet op boodschappenlijst".
  </p>
  <div id="lijst"></div>
  <button type="button" class="wis-knop" id="wis" hidden>Wis lijst</button>
</Basis>

<script>
  import { bewaarCategorie, bewaarLijst, categorieUitCache, laadLijst, perCategorie, samengevoegd, verwijderRij, zetCategorie, CATEGORIE_LABELS } from '../lib/boodschappen';
  import { herkenCategorie } from '../lib/categorie-ai';

  const lijstElement = document.querySelector<HTMLElement>('#lijst')!;
  const leegElement = document.querySelector<HTMLElement>('#leeg')!;
  const wisKnop = document.querySelector<HTMLButtonElement>('#wis')!;
  const formulier = document.querySelector<HTMLFormElement>('#toevoegen')!;
  const invoer = document.querySelector<HTMLInputElement>('#invoer')!;
  const invoerAantal = document.querySelector<HTMLSelectElement>('#invoer-aantal')!;
  const apiSleutel = document.querySelector<HTMLInputElement>('#api-sleutel')!;
  const API_SLEUTEL_OPSLAG = 'anthropic-api-sleutel';

  function toon() {
    const lijst = laadLijst();
    const groepen = perCategorie(samengevoegd(lijst.items));
    lijstElement.textContent = '';
    leegElement.hidden = groepen.length > 0;
    wisKnop.hidden = groepen.length === 0;

    for (const groep of groepen) {
      const kop = document.createElement('h2');
      kop.textContent = CATEGORIE_LABELS[groep.categorie];
      lijstElement.append(kop);

      const ul = document.createElement('ul');
      ul.className = 'ingredienten';
      for (const rij of groep.rijen) {
        const li = document.createElement('li');
        const label = document.createElement('label');
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.checked = lijst.afgevinkt.includes(rij.sleutel);
        checkbox.addEventListener('change', () => {
          const actueel = laadLijst();
          actueel.afgevinkt = checkbox.checked
            ? [...new Set([...actueel.afgevinkt, rij.sleutel])]
            : actueel.afgevinkt.filter((sleutel) => sleutel !== rij.sleutel);
          bewaarLijst(actueel);
        });
        const naam = document.createElement('span');
        naam.className = 'ingredient-naam';
        naam.textContent = rij.tekst;
        label.append(checkbox, naam);
        if (rij.hoeveelheid !== undefined) {
          const hoeveelheid = document.createElement('span');
          hoeveelheid.className = 'ingredient-hoeveelheid';
          hoeveelheid.textContent = rij.hoeveelheid;
          label.append(hoeveelheid);
        }
        const verwijder = document.createElement('button');
        verwijder.type = 'button';
        verwijder.className = 'rij-verwijder';
        verwijder.textContent = '×';
        verwijder.setAttribute('aria-label', `Verwijder ${rij.tekst}`);
        verwijder.addEventListener('click', (gebeurtenis) => {
          gebeurtenis.preventDefault();
          bewaarLijst(verwijderRij(laadLijst(), rij.sleutel));
          toon();
        });
        label.append(verwijder);
        li.append(label);
        ul.append(li);
      }
      lijstElement.append(ul);
    }
  }

  wisKnop.addEventListener('click', () => {
    bewaarLijst({ items: [], afgevinkt: [] });
    toon();
  });

  apiSleutel.value = localStorage.getItem(API_SLEUTEL_OPSLAG) ?? '';
  apiSleutel.addEventListener('change', () => {
    if (apiSleutel.value === '') {
      localStorage.removeItem(API_SLEUTEL_OPSLAG);
    } else {
      localStorage.setItem(API_SLEUTEL_OPSLAG, apiSleutel.value);
    }
  });

  formulier.addEventListener('submit', (gebeurtenis) => {
    gebeurtenis.preventDefault();
    const naam = invoer.value.trim();
    if (naam === '') return;
    const aantal = Number(invoerAantal.value);
    const categorieUitLokaleCache = categorieUitCache(naam);
    const categorie = categorieUitLokaleCache ?? 'overig';
    const lijst = laadLijst();
    lijst.items.push({ naam, hoeveelheid: aantal, categorie });
    bewaarLijst(lijst);
    invoer.value = '';
    invoer.focus();
    toon();

    if (categorieUitLokaleCache !== undefined || apiSleutel.value === '') return;
    void herkenCategorie(naam, apiSleutel.value)
      .then((herkendeCategorie) => {
        if (herkendeCategorie === undefined) {
          console.warn('Automatische categorisatie gaf geen geldige categorie terug.');
          return;
        }
        bewaarCategorie(naam, herkendeCategorie);
        bewaarLijst(zetCategorie(laadLijst(), naam, herkendeCategorie));
        toon();
      })
      .catch((fout) => console.warn('Automatische categorisatie is niet gelukt.', fout));
  });

  toon();
</script>
