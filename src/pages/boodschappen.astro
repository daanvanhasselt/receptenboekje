---
import Basis from '../layouts/Basis.astro';
import { pad } from '../lib/pad';
---
<Basis titel="Boodschappen" actief="boodschappen">
  <h1>🛒 Boodschappen</h1>
  <form class="toevoegen" id="toevoegen">
    <input type="text" id="invoer" placeholder="Voeg toe… (bijv. appels)" autocomplete="off" />
    <select id="invoer-aantal" aria-label="Aantal">
      {Array.from({ length: 10 }, (_, index) => (
        <option value={index + 1} selected={index === 0}>{index + 1}</option>
      ))}
    </select>
    <button type="submit" aria-label="Voeg toe">+</button>
  </form>
  <details class="ai-instellingen">
    <summary>AI-instellingen</summary>
    <label for="api-sleutel">Anthropic API-sleutel</label>
    <input type="password" id="api-sleutel" autocomplete="off" placeholder="sk-ant-…" />
    <p>Wordt alleen in deze browser bewaard en gebruikt om de categorie automatisch te herkennen. Zonder sleutel komt alles onder "Overig".</p>
  </details>
  <p class="leeg" id="leeg" hidden>
    Nog niets op de lijst. Open een <a href={pad('')}>recept</a> en druk op "Zet op boodschappenlijst".
  </p>
  <div id="lijst"></div>
  <button type="button" class="wis-knop" id="wis" hidden>Wis lijst</button>
</Basis>

<script>
  import { bewaarCategorie, bewaarLijst, categorieUitCache, hoeveelheidAlsTekst, laadLijst, leesHoeveelheid, perCategorie, samengevoegd, verwijderRij, wijzigRij, zetCategorie, zetKleur, CATEGORIE_LABELS, KLEUREN, KLEUR_LABELS } from '../lib/boodschappen';
  import type { BoodschapRij, Kleur } from '../lib/boodschappen';
  import { herkenCategorie } from '../lib/categorie-ai';

  const lijstElement = document.querySelector<HTMLElement>('#lijst')!;
  const leegElement = document.querySelector<HTMLElement>('#leeg')!;
  const wisKnop = document.querySelector<HTMLButtonElement>('#wis')!;
  const formulier = document.querySelector<HTMLFormElement>('#toevoegen')!;
  const invoer = document.querySelector<HTMLInputElement>('#invoer')!;
  const invoerAantal = document.querySelector<HTMLSelectElement>('#invoer-aantal')!;
  const apiSleutel = document.querySelector<HTMLInputElement>('#api-sleutel')!;
  const API_SLEUTEL_OPSLAG = 'anthropic-api-sleutel';

  /** Sleutel van de rij waarvan het kleurpalet open staat; er is er hooguit één. */
  let openKleurSleutel: string | undefined;
  /** Sleutel van de rij die bewerkt wordt (naam en aantal); ook hooguit één. */
  let bewerkSleutel: string | undefined;

  function icoon(paden: string): string {
    return `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paden}</svg>`;
  }
  const POTLOOD = icoon('<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>');
  const VINKJE = icoon('<path d="M20 6 9 17l-5-5"/>');
  const KRUISJE = icoon('<path d="M18 6 6 18M6 6l12 12"/>');

  /** `inhoud` is vaste opmaak (een icoon of teken), nooit tekst van de gebruiker. */
  function maakKnop(klasse: string, label: string, inhoud: string, type: 'button' | 'submit' = 'button'): HTMLButtonElement {
    const knop = document.createElement('button');
    knop.type = type;
    knop.className = klasse;
    knop.setAttribute('aria-label', label);
    knop.innerHTML = inhoud;
    return knop;
  }

  function rijElement(sleutel: string): HTMLElement | undefined {
    return [...lijstElement.querySelectorAll<HTMLElement>('li')].find((li) => li.dataset.sleutel === sleutel);
  }

  /** Sluit het palet zonder de lijst opnieuw te tekenen, zodat een lopende tik op een checkbox niet verloren gaat. */
  function sluitPalet() {
    if (openKleurSleutel === undefined) return;
    openKleurSleutel = undefined;
    lijstElement.querySelector('.kleur-palet')?.remove();
    lijstElement.querySelector('.kleur-knop[aria-expanded="true"]')?.setAttribute('aria-expanded', 'false');
  }

  function maakPalet(sleutel: string, huidig: Kleur | undefined): HTMLElement {
    const palet = document.createElement('div');
    palet.className = 'kleur-palet';
    palet.setAttribute('role', 'group');
    palet.setAttribute('aria-label', 'Markeerkleur');
    for (const kleur of [undefined, ...KLEUREN]) {
      const staal = document.createElement('button');
      staal.type = 'button';
      staal.className = 'kleur-staal';
      if (kleur !== undefined) staal.dataset.kleur = kleur;
      staal.setAttribute('aria-label', kleur === undefined ? 'Geen kleur' : KLEUR_LABELS[kleur]);
      staal.setAttribute('aria-pressed', String(kleur === huidig));
      staal.addEventListener('click', () => {
        bewaarLijst(zetKleur(laadLijst(), sleutel, kleur));
        openKleurSleutel = undefined;
        toon();
        rijElement(sleutel)?.querySelector<HTMLElement>('.kleur-knop')?.focus();
      });
      palet.append(staal);
    }
    palet.addEventListener('keydown', (gebeurtenis) => {
      if (gebeurtenis.key !== 'Escape') return;
      sluitPalet();
      rijElement(sleutel)?.querySelector<HTMLElement>('.kleur-knop')?.focus();
    });
    return palet;
  }

  /** Vraagt de AI op de achtergrond om de categorie van items met deze naam die nog onder "Overig" staan. */
  function herkenOpAchtergrond(naam: string) {
    if (apiSleutel.value === '') return;
    void herkenCategorie(naam, apiSleutel.value)
      .then((herkendeCategorie) => {
        if (herkendeCategorie === undefined) {
          console.warn('Automatische categorisatie gaf geen geldige categorie terug.');
          return;
        }
        bewaarCategorie(naam, herkendeCategorie);
        bewaarLijst(zetCategorie(laadLijst(), naam, herkendeCategorie));
        // Niet opnieuw tekenen terwijl iemand een regel bewerkt: dan is het getypte weg. Bij het sluiten volgt het vanzelf.
        if (bewerkSleutel === undefined) toon();
      })
      .catch((fout) => console.warn('Automatische categorisatie is niet gelukt.', fout));
  }

  function sluitBewerken(sleutel: string) {
    bewerkSleutel = undefined;
    toon();
    rijElement(sleutel)?.querySelector<HTMLElement>('.rij-bewerk-knop')?.focus();
  }

  function maakBewerkFormulier(rij: BoodschapRij): HTMLFormElement {
    const bewerk = document.createElement('form');
    bewerk.className = 'rij-bewerk';
    bewerk.noValidate = true;

    const naamVeld = document.createElement('input');
    naamVeld.type = 'text';
    naamVeld.className = 'bewerk-naam';
    naamVeld.value = rij.tekst;
    naamVeld.autocomplete = 'off';
    naamVeld.setAttribute('aria-label', 'Naam');

    const beginAantal = rij.aantal !== undefined ? hoeveelheidAlsTekst(rij.aantal) : '';
    const aantalVeld = document.createElement('input');
    aantalVeld.type = 'text';
    aantalVeld.inputMode = 'decimal';
    aantalVeld.className = 'bewerk-hoeveelheid';
    aantalVeld.value = beginAantal;
    aantalVeld.autocomplete = 'off';
    aantalVeld.setAttribute('aria-label', 'Aantal');
    aantalVeld.addEventListener('input', () => aantalVeld.removeAttribute('aria-invalid'));

    const aantalGroep = document.createElement('div');
    aantalGroep.className = 'bewerk-aantal';
    if (rij.eenheid === undefined || rij.eenheid === 'stuk') {
      // Telbare dingen: plus en min, zodat het toetsenbord niet nodig is.
      const stap = (verschil: number, label: string, teken: string) => {
        const knop = maakKnop('bewerk-stap', label, teken);
        knop.addEventListener('click', () => {
          aantalVeld.value = hoeveelheidAlsTekst(Math.max(1, (leesHoeveelheid(aantalVeld.value) ?? 0) + verschil));
          aantalVeld.removeAttribute('aria-invalid');
        });
        return knop;
      };
      aantalGroep.append(stap(-1, 'Eén minder', '−'), aantalVeld, stap(1, 'Eén meer', '+'));
    } else {
      const eenheid = document.createElement('span');
      eenheid.className = 'bewerk-eenheid';
      eenheid.textContent = rij.eenheid;
      aantalGroep.append(aantalVeld, eenheid);
    }

    const annuleer = maakKnop('bewerk-annuleer', 'Annuleer', KRUISJE);
    annuleer.addEventListener('click', () => sluitBewerken(rij.sleutel));
    const knoppen = document.createElement('div');
    knoppen.className = 'bewerk-knoppen';
    knoppen.append(annuleer, maakKnop('bewerk-bewaar', 'Bewaar', VINKJE, 'submit'));

    const onder = document.createElement('div');
    onder.className = 'bewerk-onder';
    onder.append(aantalGroep, knoppen);
    bewerk.append(naamVeld, onder);

    bewerk.addEventListener('keydown', (gebeurtenis) => {
      if (gebeurtenis.key === 'Escape') sluitBewerken(rij.sleutel);
    });
    bewerk.addEventListener('submit', (gebeurtenis) => {
      gebeurtenis.preventDefault();
      // Een onaangeraakt aantal blijft precies zoals het was (het veld toont een afgeronde waarde).
      const aantalGewijzigd = aantalVeld.value.trim() !== beginAantal;
      const hoeveelheid = aantalGewijzigd ? leesHoeveelheid(aantalVeld.value) : undefined;
      if (aantalGewijzigd && hoeveelheid === undefined) {
        aantalVeld.setAttribute('aria-invalid', 'true');
        aantalVeld.focus();
        return;
      }
      const naam = naamVeld.value.trim();
      const hernoemd = naam !== '' && naam !== rij.tekst;
      let resultaat = wijzigRij(laadLijst(), rij.sleutel, { naam, hoeveelheid });
      // Een hernoemd item dat onder "Overig" staat krijgt alsnog een categorie, net als een nieuw item.
      const inOverig = resultaat.lijst.items.some(
        (item) => item.categorie === 'overig' && item.naam.trim().toLowerCase() === naam.toLowerCase(),
      );
      const uitCache = hernoemd && inOverig ? categorieUitCache(naam) : undefined;
      if (uitCache !== undefined) resultaat = { ...resultaat, lijst: zetCategorie(resultaat.lijst, naam, uitCache) };
      bewaarLijst(resultaat.lijst);
      sluitBewerken(resultaat.sleutel);
      if (hernoemd && inOverig && uitCache === undefined) herkenOpAchtergrond(naam);
    });
    return bewerk;
  }

  function toon() {
    const lijst = laadLijst();
    const kleuren = lijst.kleuren ?? {};
    const groepen = perCategorie(samengevoegd(lijst.items));
    lijstElement.textContent = '';
    leegElement.hidden = groepen.length > 0;
    wisKnop.hidden = groepen.length === 0;

    for (const groep of groepen) {
      const kop = document.createElement('h2');
      kop.textContent = CATEGORIE_LABELS[groep.categorie];
      lijstElement.append(kop);

      const ul = document.createElement('ul');
      ul.className = 'ingredienten';
      for (const rij of groep.rijen) {
        const li = document.createElement('li');
        li.dataset.sleutel = rij.sleutel;
        const kleur = kleuren[rij.sleutel];
        if (kleur !== undefined) li.dataset.kleur = kleur;
        if (bewerkSleutel === rij.sleutel) {
          li.append(maakBewerkFormulier(rij));
          ul.append(li);
          continue;
        }
        const label = document.createElement('label');
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.checked = lijst.afgevinkt.includes(rij.sleutel);
        checkbox.addEventListener('change', () => {
          const actueel = laadLijst();
          actueel.afgevinkt = checkbox.checked
            ? [...new Set([...actueel.afgevinkt, rij.sleutel])]
            : actueel.afgevinkt.filter((sleutel) => sleutel !== rij.sleutel);
          bewaarLijst(actueel);
        });
        const naam = document.createElement('span');
        naam.className = 'ingredient-naam';
        naam.textContent = rij.tekst;
        label.append(checkbox, naam);
        if (rij.hoeveelheid !== undefined) {
          const hoeveelheid = document.createElement('span');
          hoeveelheid.className = 'ingredient-hoeveelheid';
          hoeveelheid.textContent = rij.hoeveelheid;
          label.append(hoeveelheid);
        }
        const bewerkKnop = maakKnop('rij-bewerk-knop', `Bewerk ${rij.tekst}`, POTLOOD);
        bewerkKnop.addEventListener('click', (gebeurtenis) => {
          gebeurtenis.preventDefault();
          openKleurSleutel = undefined;
          bewerkSleutel = rij.sleutel;
          toon();
          // Op een aanraakscherm geen focus in een veld: dan springt het toetsenbord op terwijl plus/min vaak genoeg is.
          if (!matchMedia('(pointer: coarse)').matches) rijElement(rij.sleutel)?.querySelector<HTMLElement>('.bewerk-naam')?.focus();
        });
        const kleurKnop = document.createElement('button');
        kleurKnop.type = 'button';
        kleurKnop.className = 'kleur-knop';
        kleurKnop.setAttribute('aria-label', `Kleur voor ${rij.tekst}`);
        kleurKnop.setAttribute('aria-expanded', String(openKleurSleutel === rij.sleutel));
        kleurKnop.addEventListener('click', (gebeurtenis) => {
          gebeurtenis.preventDefault();
          openKleurSleutel = openKleurSleutel === rij.sleutel ? undefined : rij.sleutel;
          bewerkSleutel = undefined;
          toon();
          const nieuweRij = rijElement(rij.sleutel);
          const doel = openKleurSleutel === undefined ? '.kleur-knop' : '.kleur-staal[aria-pressed="true"]';
          nieuweRij?.querySelector<HTMLElement>(doel)?.focus();
        });
        const verwijder = document.createElement('button');
        verwijder.type = 'button';
        verwijder.className = 'rij-verwijder';
        verwijder.textContent = '×';
        verwijder.setAttribute('aria-label', `Verwijder ${rij.tekst}`);
        verwijder.addEventListener('click', (gebeurtenis) => {
          gebeurtenis.preventDefault();
          bewaarLijst(verwijderRij(laadLijst(), rij.sleutel));
          bewerkSleutel = undefined;
          toon();
        });
        label.append(bewerkKnop, kleurKnop, verwijder);
        li.append(label);
        if (openKleurSleutel === rij.sleutel) li.append(maakPalet(rij.sleutel, kleur));
        ul.append(li);
      }
      lijstElement.append(ul);
    }
  }

  document.addEventListener('click', (gebeurtenis) => {
    const doel = gebeurtenis.target;
    if (doel instanceof Element && doel.closest('.kleur-knop, .kleur-palet') !== null) return;
    sluitPalet();
  });

  wisKnop.addEventListener('click', () => {
    bewaarLijst({ items: [], afgevinkt: [] });
    bewerkSleutel = undefined;
    toon();
  });

  apiSleutel.value = localStorage.getItem(API_SLEUTEL_OPSLAG) ?? '';
  apiSleutel.addEventListener('change', () => {
    if (apiSleutel.value === '') {
      localStorage.removeItem(API_SLEUTEL_OPSLAG);
    } else {
      localStorage.setItem(API_SLEUTEL_OPSLAG, apiSleutel.value);
    }
  });

  function voegToe() {
    const naam = invoer.value.trim();
    if (naam === '') return;
    const aantal = Number(invoerAantal.value);
    const categorieUitLokaleCache = categorieUitCache(naam);
    const categorie = categorieUitLokaleCache ?? 'overig';
    const lijst = laadLijst();
    lijst.items.push({ naam, hoeveelheid: aantal, categorie });
    bewaarLijst(lijst);
    invoer.value = '';
    invoer.focus();
    bewerkSleutel = undefined;
    toon();
    if (categorieUitLokaleCache === undefined) herkenOpAchtergrond(naam);
  }

  formulier.addEventListener('submit', (gebeurtenis) => {
    gebeurtenis.preventDefault();
    voegToe();
  });

  // Enter voegt rechtstreeks toe in plaats van via een formulierverzending: die sluit op iOS het
  // schermtoetsenbord, waardoor je niet meteen het volgende item kunt typen.
  invoer.addEventListener('keydown', (gebeurtenis) => {
    if (gebeurtenis.key !== 'Enter' || gebeurtenis.isComposing) return;
    gebeurtenis.preventDefault();
    voegToe();
  });

  toon();
</script>
